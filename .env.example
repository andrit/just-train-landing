# just-train.fit front door — public build-time config.
# No app API, no secrets: this site never calls the backend. These only pick the waitlist
# target. Copy to `.env` and fill before beta. All are PUBLIC (compiled into static HTML).

# Which waitlist service the form POSTs to. One of: buttondown | kit | formspree.
# Decision D2 (see discussions/ubiquitous-language.md): buttondown for launch.
PUBLIC_WAITLIST_SERVICE=buttondown

# Buttondown: your account username. Form posts to
# https://buttondown.com/api/emails/embed-subscribe/<username>
PUBLIC_BUTTONDOWN_USERNAME=just-train

# Kit (ConvertKit) — only needed if PUBLIC_WAITLIST_SERVICE=kit. The numeric form id.
PUBLIC_KIT_FORM_ID=

# Formspree — only needed if PUBLIC_WAITLIST_SERVICE=formspree. The form hash (f/<id>).
PUBLIC_FORMSPREE_FORM_ID=

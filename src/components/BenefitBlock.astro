---
import type { BenefitBlock } from '../config/content';

interface Props {
  block: BenefitBlock;
}

const { block } = Astro.props;
---

<article class="benefit">
  <p class="eyebrow">{block.eyebrow}</p>
  <h3 class="benefit__title">{block.title}</h3>
  <p class="benefit__body">{block.body}</p>
</article>

<style>
  .benefit {
    background: var(--color-surface);
    background-image: var(--crosshatch);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .benefit__title {
    font-size: 1.6rem;
  }
  .benefit__body {
    color: var(--color-ink-muted);
  }
</style>
